<!--
  robot.xml — el robot del tutorial en MuJoCo (RFC 0011 §3.3).

  Dos ruedas motrices (izquierda y derecha) y una rueda loca atrás: no se cae
  solo, como un robot de escuela. La IMU va al centro del chassis y la cámara
  al frente, mirando hacia adelante. Lo usa examples/sim/mundo.py.

  Ejes: x = adelante, y = izquierda, z = arriba. Unidades: metros, kg, segundos.
-->
<mujoco model="robot del tutorial">
  <!-- Pasos fijos de 2 ms. "implicitfast" hace estables los actuadores de velocidad. -->
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <global offwidth="640" offheight="480"/>   <!-- tamaño máximo de la cámara sin ventana -->
  </visual>

  <asset>
    <!-- El piso de cuadros: así se nota (en la ventana y en la cámara) que el robot se mueve. -->
    <texture name="cuadros" type="2d" builtin="checker" rgb1="0.85 0.85 0.85" rgb2="0.35 0.35 0.4"
             width="256" height="256"/>
    <material name="piso" texture="cuadros" texrepeat="10 10"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="piso" type="plane" size="5 5 0.1" material="piso"/>

    <!-- Cajas de colores alrededor, para que la cámara vea algo. -->
    <geom name="caja_roja"     type="box" pos=" 1.5  0.0 0.15" size="0.15 0.15 0.15" rgba="0.9 0.2 0.2 1"/>
    <geom name="caja_verde"    type="box" pos=" 0.0  1.2 0.10" size="0.10 0.30 0.10" rgba="0.2 0.8 0.3 1"/>
    <geom name="caja_azul"     type="box" pos="-1.2 -0.8 0.20" size="0.20 0.20 0.20" rgba="0.2 0.4 0.9 1"/>
    <geom name="caja_amarilla" type="box" pos=" 1.0 -1.2 0.10" size="0.10 0.10 0.10" rgba="0.95 0.85 0.2 1"/>

    <!-- El robot, ya asentado en el piso: ruedas de 3.5 cm de radio, que en MuJoCo se hunden
         0.5 mm (así simula el contacto). Si empieza en el aire, la IMU marca 0 al caer y la
         primera lectura no es la de un robot quieto. -->
    <body name="robot" pos="0 0 0.03449">
      <freejoint name="base"/>
      <!-- Chassis: 20 × 15 × 4 cm, 1 kg. -->
      <geom name="chassis" type="box" size="0.10 0.075 0.02" mass="1" rgba="0.95 0.5 0.1 1"/>

      <!-- La IMU, al centro del chassis. En reposo el acelerómetro mide +9.81 en z,
           como una IMU de verdad (siente la gravedad). -->
      <site name="imu" pos="0 0 0" size="0.01" rgba="1 1 1 1"/>

      <!-- La cámara, al frente, mirando hacia adelante (+x). En MuJoCo una cámara
           mira hacia su -z: con xyaxes, su x apunta a la derecha del robot y su y arriba. -->
      <camera name="camara" pos="0.105 0 0.02" xyaxes="0 -1 0 0 0 1" fovy="60"/>

      <!-- Ruedas motrices: 3.5 cm de radio, un poco adelante del centro. Giran en el eje y.
           armature = la inercia del motor y su caja de engranes (sin ella, vibran). -->
      <body name="rueda_izq" pos="0.04 0.09 0">
        <joint name="rueda_izq" type="hinge" axis="0 1 0" damping="0.001" armature="0.002"/>
        <geom type="cylinder" size="0.035 0.01" zaxis="0 1 0" mass="0.05" friction="1.5 0.005 0.0001"
              rgba="0.15 0.15 0.15 1"/>
      </body>
      <body name="rueda_der" pos="0.04 -0.09 0">
        <joint name="rueda_der" type="hinge" axis="0 1 0" damping="0.001" armature="0.002"/>
        <geom type="cylinder" size="0.035 0.01" zaxis="0 1 0" mass="0.05" friction="1.5 0.005 0.0001"
              rgba="0.15 0.15 0.15 1"/>
      </body>

      <!-- Rueda loca: una bolita atrás que gira libre hacia donde sea (junta "ball"),
           con poca fricción. Si la pegas al chassis sin junta, resbala a saltitos y la
           IMU vibra de más. Va 0.25 mm más arriba que las ruedas porque carga menos y se
           hunde menos: así el chassis queda derecho (en reposo, ax = 0 y no -0.02). -->
      <body name="rueda_loca" pos="-0.07 0 -0.01975">
        <joint name="rueda_loca" type="ball" damping="0.0001"/>
        <geom name="rueda_loca" type="sphere" size="0.015" mass="0.02" friction="0.01 0.001 0.0001"
              rgba="0.6 0.6 0.6 1"/>
      </body>
    </body>
  </worldbody>

  <!-- Motores de velocidad: ctrl = rad/s deseados en la rueda (±10 rad/s ≈ ±0.35 m/s).
       mundo.py convierte el MotorCommand (-1 … +1) a este rango. forcerange es el par
       máximo del motor (N·m): con 0.12, de 0 a fondo acelera a ~1.5 m/s² (llega en ~0.2 s)
       sin que las ruedas patinen, como un robot de escuela. -->
  <actuator>
    <velocity name="rueda_izq" joint="rueda_izq" kv="0.5" ctrlrange="-10 10" forcerange="-0.12 0.12"/>
    <velocity name="rueda_der" joint="rueda_der" kv="0.5" ctrlrange="-10 10" forcerange="-0.12 0.12"/>
  </actuator>

  <sensor>
    <accelerometer name="acel" site="imu"/>   <!-- m/s², en los ejes del robot -->
    <gyro name="giro" site="imu"/>            <!-- rad/s, en los ejes del robot -->
  </sensor>
</mujoco>
